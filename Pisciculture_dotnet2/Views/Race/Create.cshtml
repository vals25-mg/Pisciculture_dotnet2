@model Pisciculture_dotnet2.ViewModels.RaceCreateViewModel

@{
    ViewData["Title"] = "Créer une race";
}

<h4>Créer une nouvelle Race</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <h5 class="mt-3">Informations de base</h5>

            <div class="form-group">
                <label asp-for="NomRace" class="control-label"></label>
                <input asp-for="NomRace" class="form-control" />
                <span asp-validation-for="NomRace" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PrixAchatKg" class="control-label"></label>
                <input asp-for="PrixAchatKg" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="PrixAchatKg" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PrixVenteKg" class="control-label"></label>
                <input asp-for="PrixVenteKg" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="PrixVenteKg" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PoidsMax" class="control-label"></label>
                <input asp-for="PoidsMax" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="PoidsMax" class="text-danger"></span>
            </div>

            <h5 class="mt-4">Données de croissance</h5>
            <p class="text-muted small">
                <i class="bi bi-info-circle"></i>
                Ces données déterminent la croissance des poissons de cette race par jour.
            </p>

            <div class="form-group">
                <label asp-for="ApportProteineG" class="control-label"></label>
                <input asp-for="ApportProteineG" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="ApportProteineG" class="text-danger"></span>
                <small class="form-text text-muted">Quantité de protéines nécessaire par jour</small>
            </div>

            <div class="form-group">
                <label asp-for="ApportGlucideG" class="control-label"></label>
                <input asp-for="ApportGlucideG" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="ApportGlucideG" class="text-danger"></span>
                <small class="form-text text-muted">Quantité de glucides nécessaire par jour</small>
            </div>

            <div class="form-group">
                <label asp-for="PoidsObtenuG" class="control-label"></label>
                <input asp-for="PoidsObtenuG" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="PoidsObtenuG" class="text-danger"></span>
                <small class="form-text text-muted">Poids gagné par jour avec ces apports</small>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Créer" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>

    @* <div class="col-md-6"> *@
    @*     <div class="card bg-light"> *@
    @*         <div class="card-body"> *@
    @*             <h5 class="card-title"><i class="bi bi-lightbulb"></i> Aide</h5> *@
    @*             <p class="card-text"> *@
    @*                 <strong>Informations de base :</strong><br/> *@
    @*                 - Le nom identifie la race<br/> *@
    @*                 - Les prix d'achat et de vente sont en Ariary par kg<br/> *@
    @*                 - Le poids max est le poids maximal que peut atteindre cette race<br/> *@
    @*             </p> *@
    @*             <p class="card-text"> *@
    @*                 <strong>Données de croissance :</strong><br/> *@
    @*                 - Ces valeurs déterminent comment les poissons grandissent<br/> *@
    @*                 - Le poids obtenu est le gain de poids quotidien en grammes *@
    @*             </p> *@
    @*         </div> *@
    @*     </div> *@
    @* </div> *@
</div>

<div class="mt-3">
    <a asp-action="Index">Retour à la liste</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}