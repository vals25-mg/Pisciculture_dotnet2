@model Pisciculture_dotnet2.ViewModels.RaceEditViewModel

@{
    ViewData["Title"] = "Modifier";
}

<h4>Modifier une Race</h4>
<hr />

@* @if (TempData["SuccessMessageRace"] != null) *@
@* { *@
@*     <div class="alert alert-success alert-dismissible fade show" role="alert"> *@
@*         @TempData["SuccessMessageRace"] *@
@*         <button type="button" class="btn-close" data-bs-dismiss="alert"></button> *@
@*     </div> *@
@* } *@

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdRace" />

            <h5 class="mt-3">Informations de base</h5>
            <div class="form-group">
                <label asp-for="NomRace" class="control-label">Nom</label>
                <input asp-for="NomRace" class="form-control" />
                <span asp-validation-for="NomRace" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PrixAchatKg" class="control-label">Prix Achat Kg (Ar)</label>
                <input asp-for="PrixAchatKg" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PrixAchatKg" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PrixVenteKg" class="control-label">Prix Vente Kg (Ar)</label>
                <input asp-for="PrixVenteKg" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PrixVenteKg" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PoidsMax" class="control-label">Poids max (kg)</label>
                <input asp-for="PoidsMax" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PoidsMax" class="text-danger"></span>
            </div>

            <h5 class="mt-4">Données de croissance</h5>
            <div class="form-group">
                <label asp-for="ApportProteineG" class="control-label">Besoin Protéine (g)</label>
                <input asp-for="ApportProteineG" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="ApportProteineG" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ApportGlucideG" class="control-label">Besoin Glucide (g)</label>
                <input asp-for="ApportGlucideG" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="ApportGlucideG" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PoidsObtenuG" class="control-label">Poids Obtenu (g)</label>
                <input asp-for="PoidsObtenuG" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PoidsObtenuG" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Modifier" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Revenir à la liste</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}