@model Pisciculture_dotnet2.Models.Dobo

@{
    ViewData["Title"] = "Create";
}

<h4>Ajout Dobo</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IdDobo" class="control-label"></label>
                <input asp-for="IdDobo" class="form-control" />
                <span asp-validation-for="IdDobo" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Ajouter" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Revenir à la liste</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
